{
  "manifest_version": 3,
  "name": "Anigamer-Redesign 3.0｜動畫瘋沉浸重製版",
  "description": "動畫瘋播放頁環境光與主題編輯器。光暈、配色與版型可獨立使用，支援字體、透明度、收合與自訂色碼。非官方工具。",
  "version": "3.0.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "動畫瘋環境光設定",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "css": [
        "motion.css",
        "page-entry.css"
      ],
      "js": [
        "page-entry.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "css": [
        "content.css",
        "effects.css",
        "settings-ui.css",
        "hero-banner.css",
        "ui-repairs.css"
      ],
      "js": [
        "hero-banner.js",
        "settings.js",
        "black-bars.js",
        "ambient-renderer.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "js": [
        "topbar-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ],
  "version_name": "3.0.0",
  "background": {
    "service_worker": "hero-cache-worker.js"
  },
  "host_permissions": [
    "https://truth.bahamut.com.tw/*",
    "https://p2.bahamut.com.tw/*",
    "https://i2.bahamut.com.tw/*",
    "https://acg.gamer.com.tw/*",
    "https://cal.syoboi.jp/*",
    "https://ja.wikipedia.org/*",
    "https://api.bgm.tv/*",
    "https://graphql.anilist.co/*",
    "https://myanimelist.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "membership-background.png"
      ],
      "matches": [
        "https://ani.gamer.com.tw/*"
      ]
    }
  ]
}
