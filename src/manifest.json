{
  "manifest_version": 3,
  "name": "動畫瘋沉浸重製版 3.0｜Anigamer-Redesign 3.0",
  "description": "動畫瘋環境光與沉浸重製介面：毛玻璃播放器、開場液態波紋、首頁足跡熱力圖＆天氣實況（靈感改作自 Hinataragi/anigamer-ambilight、jiuyang5354/bilibili-margin 與 GreatUI）。非官方工具。",
  "version": "3.5.0",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "動畫瘋環境光設定",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "css": [
        "motion.css",
        "page-entry.css",
        "content.css",
        "effects.css",
        "settings-ui.css",
        "ui-repairs.css",
        "enhancements.css"
      ],
      "js": [
        "page-entry.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/",
        "https://ani.gamer.com.tw/index.php*"
      ],
      "css": [
        "hero-banner.css",
        "home-dashboard.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/",
        "https://ani.gamer.com.tw/index.php*"
      ],
      "js": [
        "hero-banner.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/animeVideo.php*"
      ],
      "js": [
        "black-bars.js",
        "ambient-renderer.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/animeVideo.php*",
        "https://ani.gamer.com.tw/viewList.php*"
      ],
      "js": [
        "studio-credits.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/animeList.php*",
        "https://ani.gamer.com.tw/mygather.php*"
      ],
      "js": [
        "studio-catalog.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/viewList.php*"
      ],
      "js": [
        "opencc.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "js": [
        "home-dashboard.js",
        "lens-switch.js",
        "settings.js",
        "ending-audio.js",
        "content.js",
        "enhancements.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/animeVideo.php*"
      ],
      "js": [
        "opencc.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "js": [
        "topbar-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ],
  "version_name": "3.5.0",
  "background": {
    "service_worker": "hero-cache-worker.js"
  },
  "host_permissions": [
    "https://bahamut.akamaized.net/*",
    "https://gnn.gamer.com.tw/*",
    "https://truth.bahamut.com.tw/*",
    "https://p2.bahamut.com.tw/*",
    "https://i2.bahamut.com.tw/*",
    "https://acg.gamer.com.tw/*",
    "https://cal.syoboi.jp/*",
    "https://ja.wikipedia.org/*",
    "https://zh.wikipedia.org/*",
    "https://api.bgm.tv/*",
    "https://graphql.anilist.co/*",
    "https://api.aniskip.com/*",
    "https://api.mymemory.translated.net/*",
    "https://www.aniplex.co.jp/*",
    "https://www.youtube.com/*",
    "https://myanimelist.net/*",
    "https://api.gamer.com.tw/*",
    "https://wall.gamer.com.tw/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipwho.is/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "membership-background.png",
        "icon-32.png"
      ],
      "matches": [
        "https://ani.gamer.com.tw/*"
      ]
    }
  ]
}
